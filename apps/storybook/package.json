{
  "name": "website-storybook",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --docs",
    "preview-storybook": "serve storybook-static",
    "lint": "eslint 'stories/**/*.{tsx,jsx,js}'",
    "sort": "npx eslint stories --fix --rule simple-import-sort/imports:error",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf storybook-static && rm -rf coverage"
  },
  "dependencies": {
    "@react-component-library/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-viewport": "8.5.8",
    "@storybook/addon-actions": "^8.2.6",
    "@storybook/addon-essentials": "8.5.8",
    "@storybook/addon-links": "8.5.8",
    "@storybook/react": "8.5.8",
    "@storybook/react-vite": "8.5.8",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.20",
    "eslint": "^9",
    "eslint-plugin-mdx": "3.1.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "0.11.2",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "serve": "^14.2.1",
    "storybook": "^8.2.6",
    "tailwindcss": "4.0.0",
    "typescript": "5.5.4",
    "vite": "^6.0.9"
  }
}
