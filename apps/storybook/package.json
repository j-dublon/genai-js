{
  "name": "website-storybook",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --docs",
    "preview-storybook": "serve storybook-static",
    "lint": "eslint 'stories/**/*.{tsx,jsx,js}'",
    "sort": "npx eslint stories --fix --rule simple-import-sort/imports:error",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf storybook-static && rm -rf coverage"
  },
  "dependencies": {
    "@react-component-library/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-viewport": "8.6.4",
    "@storybook/addon-actions": "^8.2.6",
    "@storybook/addon-essentials": "8.6.4",
    "@storybook/addon-links": "8.6.4",
    "@storybook/react": "8.6.4",
    "@storybook/react-vite": "8.6.4",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@typescript-eslint/parser": "8.29.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.21",
    "eslint": "^9",
    "eslint-plugin-mdx": "3.3.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-storybook": "0.12.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "serve": "^14.2.1",
    "storybook": "^8.2.6",
    "tailwindcss": "4.1.3",
    "typescript": "5.8.2",
    "vite": "^6.2.4",
    "vitest": "3.1.1"
  }
}
