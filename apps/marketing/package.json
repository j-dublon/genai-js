{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 3004",
    "lint": "next lint",
    "sort": "npx eslint src --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "prepare": "cd .. && husky marketing/.husky",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@react-component-library/ui": "*",
    "@tailwindcss/postcss": "4.0.9",
    "@vercel/microfrontends": "1.0.0",
    "next": "15.1.0",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "postcss": "8.5.3",
    "posthog-js": "1.222.0",
    "posthog-node": "4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.50.1",
    "@tailwindcss/vite": "4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/gtag.js": "0.0.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "1.1.36",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "^9.1.7",
    "prettier": "3.4.2",
    "tailwindcss": "4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "3.0.5"
  }
}
