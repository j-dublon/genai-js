{
  "name": "marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 3004",
    "lint": "next lint",
    "sort": "npx eslint src --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.1",
    "@react-component-library/ui": "*",
    "@types/jsonwebtoken": "9.0.9",
    "cookie": "1.0.2",
    "jsonwebtoken": "9.0.2",
    "posthog-node": "4.11.1"
  },
  "devDependencies": {
    "@types/gtag.js": "0.0.20"
  }
}
