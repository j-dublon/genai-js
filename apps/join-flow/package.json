{
  "name": "join-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:codegen && next dev --turbopack",
    "build": "npm run build:codegen && next build",
    "build:codegen": "graphql-codegen",
    "update-schema": "npm run ts-node fetch-graphql-schema.ts",
    "start": "next start",
    "start:e2e": "next start -p 3003",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "lint": "next lint",
    "sort": "npx eslint src --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "4.1.3",
    "@react-component-library/ui": "*",
    "@tailwindcss/postcss": "4.0.12",
    "@vercel/microfrontends": "1.0.0",
    "@vercel/speed-insights": "1.2.0",
    "graphql": "16.10.0",
    "graphql-request": "7.1.2",
    "next": "15.2.1",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "7.54.2",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/typescript": "4.1.5",
    "@graphql-codegen/typescript-operations": "4.5.1",
    "@playwright/test": "1.51.0",
    "@tailwindcss/vite": "4.0.12",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "1.1.36",
    "dotenv": "16.4.7",
    "dotenv-cli": "8.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "prettier": "3.5.3",
    "tailwindcss": "4.0.12",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "3.0.8"
  }
}
