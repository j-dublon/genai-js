{
  "name": "join-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:codegen && next dev --turbopack",
    "build": "npm run build:codegen && next build",
    "build:codegen": "graphql-codegen",
    "update-schema": "ts-node fetch-graphql-schema.ts",
    "start": "next start",
    "start:e2e": "next start -p 3005",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "lint": "next lint",
    "sort": "npx eslint src --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.1",
    "@hookform/resolvers": "5.0.1",
    "@react-component-library/ui": "*",
    "graphql": "16.11.0",
    "graphql-request": "7.1.2",
    "react-hook-form": "7.56.0",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/typescript": "4.1.5",
    "@graphql-codegen/typescript-operations": "4.6.0",
    "dotenv": "16.5.0",
    "dotenv-cli": "8.0.0",
    "ts-node": "10.9.2"
  }
}
