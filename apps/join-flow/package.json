{
  "name": "join-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 3005",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "lint": "next lint",
    "sort": "npx eslint src --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf .next && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@axe-core/playwright": "4.10.1",
    "@cuckoointernet/util-squid-network-requests": "5.2.1",
    "@hookform/resolvers": "5.0.1",
    "@react-component-library/ui": "*",
    "lodash": "4.17.21",
    "react-hook-form": "7.62.0",
    "remark": "15.0.1",
    "remark-html": "16.0.1",
    "zod": "3.25.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/lodash": "4.17.16",
    "dotenv": "17.2.0",
    "dotenv-cli": "10.0.0",
    "ts-node": "10.9.2"
  }
}
