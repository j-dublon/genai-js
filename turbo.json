{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["JOIN_FLOW_URL"]
    },
    "check-types": {
      "dependsOn": ["@react-component-library/ui#build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "sort": {
      "dependsOn": ["^sort"],
      "cache": false
    },
    "format": {
      "cache": false,
      "persistent": false
    }
  }
}
