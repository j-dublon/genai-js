{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:codegen"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["JOIN_FLOW_URL", "TRUSTPILOT_API_KEY"]
    },
    "build:codegen": {
      "cache": true,
      "outputs": ["src/__generated__/**"],
      "env": [
        "NEXT_PUBLIC_CUCKOO_GRAPH_ENDPOINT",
        "NEXT_PUBLIC_CUCKOO_GRAPH_APIKEY",
        "TRUSTPILOT_API_KEY"
      ]
    },
    "check-types": {
      "dependsOn": ["@react-component-library/ui#build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "sort": {
      "dependsOn": ["^sort"],
      "cache": false
    },
    "format": {
      "cache": false,
      "persistent": false
    },
    "e2e": {
      "dependsOn": ["^build", "build"],
      "outputs": ["playwright-report/**"],
      "env": ["CI"]
    }
  }
}
