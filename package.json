{
  "name": "website-rework",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check-types": "turbo run check-types",
    "e2e": "turbo run e2e",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "sort": "turbo run sort",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish",
    "prepare": "husky",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf .turbo"
  },
  "packageManager": "npm@11.4.0",
  "dependencies": {
    "@tailwindcss/postcss": "4.1.3",
    "@vercel/microfrontends": "1.1.0",
    "@vercel/speed-insights": "1.2.0",
    "date-fns": "4.1.0",
    "next": "15.3.0",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "postcss": "8.5.3",
    "posthog-js": "1.242.1",
    "query-string": "9.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.52.0",
    "@tailwindcss/vite": "4.1.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/eslint-plugin": "1.1.36",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "flat-cache": "6.1.7",
    "husky": "9.1.7",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.3",
    "ts-node": "^10.9.2",
    "turbo": "2.5.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.1"
  },
  "engines": {
    "node": "^22.15.0",
    "npm": "^11.2.0"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "optionalDependencies": {
    "@esbuild/linux-x64": "latest",
    "@rollup/rollup-linux-x64-gnu": "latest",
    "@swc/core-linux-x64-gnu": "^1.3.7",
    "@tailwindcss/oxide-linux-x64-gnu": "4.1.3",
    "lightningcss-linux-x64-gnu": "1.30.1"
  }
}
