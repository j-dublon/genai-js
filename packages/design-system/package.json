{
  "name": "@react-component-library/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.client.d.ts",
      "import": "./dist/index.client.es.js",
      "require": "./dist/index.client.cjs.js"
    },
    "./server": {
      "types": "./dist/index.server.d.ts",
      "import": "./dist/index.server.es.js",
      "require": "./dist/index.server.cjs.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:dev:watch": "vite build --watch --mode development",
    "lint": "eslint .",
    "sort": "npx eslint lib --fix --rule simple-import-sort/imports:error",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf coverage && rm -rf tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.3.1",
    "classnames": "2.5.1",
    "framer-motion": "12.4.10",
    "posthog-js": "1.222.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.10.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "8.21.0",
    "@typescript-eslint/parser": "8.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-react-swc": "3.8.0",
    "@vitest/coverage-v8": "3.0.8",
    "@vitest/eslint-plugin": "1.1.36",
    "autoprefixer": "^10.4.16",
    "eslint": "9.19.0",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.15.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jsdom": "26.0.0",
    "postcss": "8.5.3",
    "tailwind-scrollbar": "4.0.1",
    "tailwindcss": "4.0.12",
    "ts-jest": "^29.2.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "8.21.0",
    "vite": "^6.0.9",
    "vite-plugin-dts": "^4.3.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.0.8"
  },
  "optionalDependencies": {
    "@swc/core-linux-x64-gnu": "^1.3.7",
    "@tailwindcss/oxide-linux-x64-gnu": "4.0.12",
    "lightningcss-linux-x64-gnu": "1.29.1"
  }
}
