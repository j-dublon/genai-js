{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "esModuleInterop": true,
     "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "node",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@components/*": ["packages/design-system/lib/components/*"],
      "@organisms/*": ["packages/design-system/lib/components/organisms/*"],
      "@icons/*": ["packages/design-system/lib/components/icons/*"],
      "@images/*": ["packages/design-system/lib/images/*"],
      "@utils/*": ["packages/design-system/lib/utils/*"]
    }
  },
  "include": ["packages/design-system/lib/**/*", "./jest.setup.ts", "./jest.config.js"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
